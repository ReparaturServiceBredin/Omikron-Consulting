# =====================================================================================================
#  Umgebungsvariablen (Zugangsdaten und rechnerabhängige Werte)
# =====================================================================================================
#  Lokal / Docker:  diese Datei nach ".env" kopieren und Werte eintragen. Die .env NIE ins Repository hochladen.
#  Azure:           dieselben Namen und Werte im Azure-Portal eintragen
#                   (App Service → Einstellungen → Umgebungsvariablen), siehe EINRICHTUNG.md.
#
#  Firmenname, Logo, Farben und Standardwerte stehen NICHT hier, sondern in firma.toml.
#  Leere Werte = Standard. Kein Passwort, kein Schlüssel und kein Zugang steht fest im Programmcode:
#  E-Mail-Passwörter werden in der App eingegeben und verschlüsselt im Datenordner gespeichert.

# ---------------------------------------------------------------- Betrieb
# desktop (Standard: Windows mit Fenster) oder server (Linux/Docker/Azure: nur Browser-Zugriff)
RSB_MODUS=
# Datenordner (Datenbank, Belege, Fotos, Sicherungen). Azure App Service: /home/daten  Docker: /daten
RSB_DATEN=
# Netzwerkadresse, auf der das Programm lauscht (Server/Azure: 0.0.0.0)
RSB_HOST=
# Port (Standard 5000; Azure App Service: 8000)
RSB_PORT=
# gleichzeitige Anfragen (Standard 8)
RSB_THREADS=
# 1 = läuft hinter einem Reverse-Proxy (Azure, Caddy, nginx): echte Client-Adresse und HTTPS übernehmen
RSB_HINTER_PROXY=
# 1 = Zugriff nur per HTTPS (Cookies mit Secure-Flag). Auf Azure: 1
RSB_SICHERE_COOKIES=
# INFO (Standard), DEBUG, WARNING
RSB_LOG_STUFE=
# Datenbank-Modus: WAL (Standard, lokale Festplatte) oder DELETE (Netzlaufwerk, z. B. Azure App Service /home)
RSB_SQLITE_JOURNAL=

# ---------------------------------------------------------------- Anmeldung
# entra = Anmeldung mit dem Microsoft-Konto (Microsoft Entra ID) über die Authentifizierung von Azure App Service.
#         NUR auf Azure App Service mit eingeschalteter Authentifizierung verwenden!
# leer  = eigene Passwort-Anmeldung des Programms
RSB_ANMELDUNG=
# E-Mail-Adressen mit allen Rechten (Rolle „Inhaber“), mit Komma getrennt. Alle anderen sind „Mitarbeiter“.
RSB_ENTRA_INHABER=
# optional: Zugang zusätzlich auf diese Adressen/Domains begrenzen, z. B. @omikronconsulting.de
RSB_ENTRA_ERLAUBT=
# optional: Verzeichnis-ID (Tenant-ID) des Microsoft-365-Kontos des Kunden (zusätzliche Prüfung)
RSB_ENTRA_TENANT_ID=
# nur Server-Modus OHNE Microsoft-Anmeldung: Passwort beim ersten Start setzen (danach wieder leeren)
RSB_ERSTES_PASSWORT=

# ---------------------------------------------------------------- SharePoint-Einbettung
# Adressen, die das Programm im iframe anzeigen dürfen (mit Leerzeichen getrennt), z. B.
#   https://KUNDE.sharepoint.com
# Leer = Einbetten nur auf der eigenen Seite (Standard).
RSB_EINBETTEN_ERLAUBT=

# ---------------------------------------------------------------- Windows-EXE
# 1 = beim Start kein Fenster öffnen
RSB_KEIN_BROWSER=
# 1 = kein Symbol neben der Uhr
RSB_KEIN_SYMBOL=
# 1 = keine automatischen Updates
RSB_KEIN_UPDATE=
# anderes GitHub-Repository für Updates (Standard: firma.toml → update_repo)
RSB_UPDATE_REPO=
# 1 = beim ersten Start alte Datenordner auf dem Rechner suchen und übernehmen (Standard: aus)
RSB_ALTE_DATEN_SUCHEN=

# ---------------------------------------------------------------- Sonstiges
# andere firma.toml verwenden (Standard: mitgelieferte Datei)
RSB_FIRMA_DATEI=
